# Copy to .env and tweak as needed. Real environment variables override these.

# --- Coins to stream ---
# Comma-separated base assets and the fiat they are priced in.
COINS=BTC,ETH,SOL
QUOTE_CURRENCY=USD

# --- Polling ---
POLL_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10

# --- Price API (Coinbase public spot, keyless) ---
PRICE_API_URL=https://api.coinbase.com/v2/prices/{pair}/spot

# --- Redpanda / Kafka ---
BOOTSTRAP_SERVERS=localhost:9092
TOPIC=crypto-prices

# --- Consumer (topic -> Postgres) ---
CONSUMER_GROUP=crypto-price-writer
CONSUMER_BATCH_SIZE=100
CONSUMER_BATCH_TIMEOUT_SECONDS=2

# --- Postgres ---
# From the host, Postgres is published on 5434 (see docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=crypto
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto
